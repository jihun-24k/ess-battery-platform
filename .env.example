# 이 파일은 자동 로딩되지 않습니다. 셸 export 또는 실행 환경 secret 주입을 사용하세요.
DATABASE_URL=postgresql://USER@127.0.0.1:5432/ess_agent_demo
PLATFORM_TEST_DATABASE_URL=postgresql://USER@127.0.0.1:5432/ess_platform_test
OPENAI_API_KEY=
ESS_AGENT_MODEL=gpt-4.1-mini
# 미설정이면 승인 API를 열지 않습니다. 32자 이상 토큰을 직접 관리하세요.
ESS_APPROVER_TOKEN=
ESS_APPROVER_ID=local-operator
